{
  "name": "gestao",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/start-db.mts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "tsx scripts/start-db.mts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "predb:migrate": "tsx scripts/start-db.mts",
    "db:migrate": "tsx scripts/migrate.mts",
    "predb:reset": "tsx scripts/start-db.mts",
    "db:reset": "tsx scripts/reset-db.mts",
    "db:wipe": "tsx scripts/wipe-db.mts",
    "create-admin": "tsx scripts/create-admin.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "better-auth": "^1.7.25",
    "decimal.js": "^10.6.0",
    "docx": "^9.16.0",
    "drizzle-orm": "^0.45.4",
    "flowbite-react": "^0.12.17",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  }
}
